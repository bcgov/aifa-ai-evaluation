# Judge model for llm-rubric grading. Any endpoint that serves
# {endpoint}/openai/deployments/{deployment}/chat/completions works, including a gateway path prefix.
AUDIT_LLM_ENDPOINT=https://<host>/<optional-gateway-path>
AUDIT_LLM_API_KEY=
AUDIT_LLM_DEPLOYMENT=gpt-5.1
AUDIT_LLM_API_VERSION=2024-10-21

# System under test: the AIFA backend WebSocket endpoint.
BACKEND_API_URL=wss://<host>/ws
BACKEND_API_TIMEOUT=30
BACKEND_CLIENT_ID=11111111-1111-4111-8111-111111111111
BACKEND_APPLICATION_ID=234554
BACKEND_STEP_NUMBER=step2-Eligibility

# Attack-generation model key (red-team commands only).
ADVERSARIAL_OPENAI_API_KEY=

# Optional Azure Blob storage. Leave empty to use the local data_promptfoo/ and results-promptfoo/ folders.
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT_NAME=
# PROMPTFOO_DATA_CONTAINER_NAME=promptfoo-data
# PROMPTFOO_RESULTS_CONTAINER_NAME=promptfoo-results
