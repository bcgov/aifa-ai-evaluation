# Point Promptfoo at the repo's real HTTP API endpoint.
APP_WRAPPER_URL=http://localhost:8000/api/chat
BACKEND_API_URL=http://localhost:8000
BACKEND_API_TIMEOUT=30
BACKEND_CLIENT_ID=11111111-1111-4111-8111-111111111111
BACKEND_APPLICATION_ID=234554
BACKEND_STEP_NUMBER=step2-Eligibility

# Azure OpenAI credentials used by Promptfoo's LLM rubric grader
# IMPORTANT: this must be a real Azure OpenAI resource endpoint, not a custom AI gateway URL.
# Promptfoo's llm-rubric grader calls /openai/deployments/{deployment}/chat/completions
# and will return 404 if the endpoint does not support the Azure OpenAI API contract.
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://css-ai-dev-openai-east.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.1-chat
AZURE_OPENAI_DEPLOYMENT=gpt-5.1-chat

# Adversarial Azure OpenAI Configuration (used by red-team attack generation)
ADVERSARIAL_OPENAI_ENDPOINT=https://css-ai-dev-openai-east.openai.azure.com
ADVERSARIAL_OPENAI_API_KEY=your_azure_openai_api_key_here
ADVERSARIAL_OPENAI_DEPLOYMENT=gpt-5.1-chat
ADVERSARIAL_OPENAI_API_VERSION=2025-01-01-preview

# Proxy-based switching for Azure dev vs local dev without any code changes.
# This project is configured to use the local SOCKS proxy on port 8081 when the
# Azure endpoint is only reachable through the corporate tunnel.
HTTP_PROXY=socks5h://127.0.0.1:8081
HTTPS_PROXY=socks5h://127.0.0.1:8081
ALL_PROXY=socks5h://127.0.0.1:8081

# Local direct access:
# unset HTTP_PROXY HTTPS_PROXY ALL_PROXY

# Promptfoo run metadata
PROMPTFOO_RUN_NAME=form-assist-eval
PROMPTFOO_SCENARIO=hosted-app-eval
PROMPTFOO_TEST_CASES_FILE=../evaluation/data/test_cases.json
PROMPTFOO_OUTPUT_DIR=results
