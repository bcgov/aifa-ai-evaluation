# Azure OpenAI Configuration
# Use the same Azure resource for the main model and the adversarial model so there is
# no split-brain configuration between local dev and Azure dev access.
#
# Required reminder: this repo intentionally keeps the endpoint stable and switches the
# network route via environment variables only. No code change should be required when moving
# between Azure dev and local dev.
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://css-ai-dev-openai-east.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.1-chat

# Adversarial Azure OpenAI Configuration (used by red-team attack generation)
# For the adversarial target, either point this at the same resource as the primary endpoint
# or leave it blank to fallback to AZURE_OPENAI_ENDPOINT automatically.
ADVERSARIAL_OPENAI_ENDPOINT=https://css-ai-dev-openai-east.openai.azure.com
ADVERSARIAL_OPENAI_API_KEY=your_azure_openai_api_key_here
ADVERSARIAL_OPENAI_DEPLOYMENT=gpt-5.1-chat
ADVERSARIAL_OPENAI_API_VERSION=2025-01-01-preview

# Proxy-based switching for Azure dev vs local dev without any code changes.
# Proxy usage is opt-in: do not set a SOCKS proxy unless your environment actually requires it.
# Azure dev tunnel access (only if you are using a local SOCKS tunnel):
# export HTTP_PROXY=socks5h://127.0.0.1:8081
# export HTTPS_PROXY=socks5h://127.0.0.1:8081
# export ALL_PROXY=socks5h://127.0.0.1:8081
# Local direct access:
# unset HTTP_PROXY HTTPS_PROXY ALL_PROXY
# Optional override: set RED_TEAM_PROXY_URL or PROXY_URL when you want the app to enable a tunnel.
# USE_AZURE_PROXY=false disables any runtime proxy injection even if those variables are present.
#
# Important: Azure can still reject the request even when the app is reaching the endpoint
# because private endpoint access or Azure content filtering may reject the prompt before
# PyRIT receives the expected Crescendo JSON response schema.

# Backend API Configuration
BACKEND_API_URL=http://localhost:8000
BACKEND_API_TIMEOUT=30

# Evaluation Configuration
EVALUATION_RUN_NAME=test_evaluation_run
EVALUATION_SCENARIO=basic_evaluation

# Logging
LOG_LEVEL=INFO

# Enabled Evaluators
# Available: groundedness, code_vulnerability
# Comma-separated list, e.g., "groundedness,code_vulnerability"
ENABLED_EVALUATORS=groundedness

# Evaluator Thresholds
# Groundedness (0.0-1.0): How much generated text is grounded in provided context
GROUNDEDNESS_THRESHOLD=0.5

# Code Vulnerability (0.0-1.0): Code safety threshold (higher = stricter)
CODE_VULNERABILITY_THRESHOLD=0.8

# Azure AI Project Configuration (required for code_vulnerability evaluator)
# Format: https://your-ai-project.services.ai.azure.com/api/projects/your-project-name
# Or provide AZURE_OPENAI_DEPLOYMENT for Azure OpenAI-based evaluators
AZURE_AI_PROJECT=https://ai-services-hub-test-foundry.services.ai.azure.com/api/projects/wlrs-water-form-assistant-project

# Azure AI Search Configuration (optional - for context retrieval instead of files)
# If not configured, will fallback to file-based context (data/context.json)
AZURE_SEARCH_ENDPOINT=https://your-search-resource.search.windows.net/
AZURE_SEARCH_API_KEY=your-search-api-key-here
AZURE_SEARCH_INDEX_NAME=your-index-name
AZURE_SEARCH_TOP=3
AZURE_SEARCH_TRIM_LENGTH=500
AZURE_SEARCH_ENABLE_TRIMMING=true
AZURE_SEARCH_INCLUDE_TOTAL_COUNT=true
AZURE_SEARCH_QUERY_TYPE=simple
AZURE_SEARCH_SEMANTIC_CONFIGURATION=default
AZURE_SEARCH_QUERY_CAPTION=extractive
AZURE_SEARCH_QUERY_ANSWER=extractive
AZURE_SEARCH_QUERY_ANSWER_COUNT=3
AZURE_SEARCH_QUERY_LANGUAGE=en-us
